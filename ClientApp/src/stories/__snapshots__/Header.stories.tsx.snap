exports[`Components/Header Default smoke-test: components-header--default.html 1`] = `
<div data-lds-theme="qm-light"
     class="lds-root"
>
  <header class="qm_scheduling_Header">
    <h1>
      Schedule List
    </h1>
    <div>
      <label class="lds-form-label"
             for="selectLanguage"
      >
        Select Language :
      </label>
      <select class="lds-form-select"
              id="selectLanguage"
      >
        <option value="en">
          English
        </option>
        <option value="fr">
          French
        </option>
        <option value="ar">
          Arabic
        </option>
      </select>
    </div>
  </header>
</div>
`;

